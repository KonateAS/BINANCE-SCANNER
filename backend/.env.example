BINANCE_REST=https://fapi.binance.com
BINANCE_WS=wss://fstream.binance.com/market/stream
HISTORY_CANDLES=120
WS_GROUP_SIZE=180
WS_SILENCE_TIMEOUT_SECONDS=180
# Set a private secret before starting the backend to enable loopback-only HTTP 418 recovery.
